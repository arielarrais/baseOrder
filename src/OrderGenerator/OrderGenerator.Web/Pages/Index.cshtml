@page
@model IndexModel
@{
    ViewData["Title"] = "Order Generator";
}

<div class="page-header">
    <h1>Order Generator</h1>
    <p class="subtitle">Envie ordens FIX para o OrderAccumulator em tempo real</p>
</div>

@if (Model.Response != null)
{
    var statusClass = Model.Response.Status switch
    {
        "Accepted" => "alert-accepted",
        "Rejected" => "alert-rejected",
        _ => "alert-pending"
    };
    <div class="alert-result @statusClass mb-4" id="order-alert">
        <div class="alert-result-body">
            <span class="alert-message" id="alert-message">@Model.Response.Message</span>
            <div class="alert-time">@Model.Response.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</div>
            @if (Model.PendingOrderId != null)
            {
                <div class="alert-time" id="order-status" data-order-id="@Model.PendingOrderId">
                    <span id="status-text"></span>
                </div>
            }
        </div>
    </div>
}

<div class="main-grid">
    <div class="card-dark">
        <div class="card-header">
            <h5>
                <span class="card-header-icon icon-exposure">$</span>
                Exposicao Financeira
            </h5>
            <span class="limit-badge">Limite: R$ @Model.ExposureLimit.ToString("N0")</span>
        </div>
        <div class="card-body" style="padding: 0;">
            <table class="table-exposure">
                <thead>
                    <tr>
                        <th>Simbolo</th>
                        <th>Quantidade</th>
                        <th>Exposicao</th>
                        <th>Utilizacao</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var exp in Model.Exposures)
                    {
                        var utilization = Model.ExposureLimit > 0 ? (Math.Abs(exp.Value.Exposure) / Model.ExposureLimit * 100) : 0;
                        var barClass = utilization > 80 ? "bar-red" : utilization > 50 ? "bar-yellow" : "bar-green";
                        <tr>
                            <td><span class="symbol-badge">@exp.Key</span></td>
                            <td class="exposure-value">@exp.Value.Quantity.ToString("N0")</td>
                            <td class="exposure-value @(exp.Value.Exposure > 0 ? "exposure-positive" : exp.Value.Exposure < 0 ? "exposure-negative" : "exposure-zero")">
                                R$ @exp.Value.Exposure.ToString("N2")
                            </td>
                            <td>
                                <div class="exposure-bar-container">
                                    <div class="exposure-bar">
                                        <div class="exposure-bar-fill @barClass" style="width: @utilization.ToString("F1")%"></div>
                                    </div>
                                    <span class="exposure-bar-pct">@utilization.ToString("F1")%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card-dark">
        <div class="card-header">
            <h5>
                <span class="card-header-icon icon-order">#</span>
                Nova Ordem
            </h5>
        </div>
        <div class="card-body">
            <form class="form-dark" id="order-form">
                <input type="hidden" name="IdempotencyKey" value="@Model.IdempotencyKey" />
                <div class="form-section-label">Parametros</div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label">Symbol</label>
                        <select asp-for="Order.Symbol" class="form-select" required>
                            <option value="">Selecione</option>
                            <option value="PETR4">PETR4</option>
                            <option value="VALE3">VALE3</option>
                            <option value="VIIA4">VIIA4</option>
                        </select>
                        <span asp-validation-for="Order.Symbol" class="text-danger"></span>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Side</label>
                        <select asp-for="Order.Side" class="form-select" required>
                            <option value="">Selecione</option>
                            <option value="Compra">Compra</option>
                            <option value="Venda">Venda</option>
                        </select>
                        <span asp-validation-for="Order.Side" class="text-danger"></span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <label class="form-label">Quantidade</label>
                        <input asp-for="Order.Quantity" type="number" class="form-control"
                               placeholder="0" min="1" max="99999" required />
                        <span asp-validation-for="Order.Quantity" class="text-danger"></span>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Preco</label>
                        <input asp-for="Order.Price" type="number" step="0.01" class="form-control"
                               placeholder="0.00" min="0.01" max="999.99" required />
                        <span asp-validation-for="Order.Price" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-send w-100" id="btn-send">
                    Enviar Ordem
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var form = document.getElementById('order-form');
            if (form) {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    var btn = document.getElementById('btn-send');
                    if (btn) {
                        btn.disabled = true;
                        btn.textContent = 'Enviando...';
                    }
                    var formData = new FormData(form);
                    var payload = new FormData();
                    payload.append('Symbol', formData.get('Order.Symbol'));
                    payload.append('Side', formData.get('Order.Side'));
                    payload.append('Quantity', formData.get('Order.Quantity'));
                    payload.append('Price', formData.get('Order.Price'));
                    payload.append('IdempotencyKey', formData.get('IdempotencyKey'));
                    var xhr = new XMLHttpRequest();
                    xhr.open('POST', '/api/orders');
                    xhr.onload = function() {
                        if (xhr.status === 200) {
                            var data = JSON.parse(xhr.responseText);
                            history.replaceState(null, '', '/?orderId=' + data.orderId);
                            window.location.href = '/?orderId=' + data.orderId;
                        }
                    };
                    xhr.send(payload);
                });
            }

            initPolling();
        });

        function initPolling() {
            var statusElement = document.getElementById('order-status');
            if (!statusElement) return;

            var orderId = statusElement.getAttribute('data-order-id');
            var statusText = document.getElementById('status-text');
            var alertMessage = document.getElementById('alert-message');
            var alertDiv = document.getElementById('order-alert');
            var pollCount = 0;
            var maxPolls = 30;

            statusText.textContent = 'Aguardando processamento...';

            var poll = setInterval(function() {
                pollCount++;
                if (pollCount > maxPolls) {
                    clearInterval(poll);
                    statusText.textContent = 'Timeout';
                    return;
                }

                var xhr = new XMLHttpRequest();
                xhr.open('GET', '/orders/' + orderId + '/status');
                xhr.onload = function() {
                    if (xhr.status === 200) {
                        var data = JSON.parse(xhr.responseText);
                        if (data.status !== 'Pending') {
                            clearInterval(poll);
                            if (data.status === 'Accepted') {
                                alertDiv.className = 'alert-result alert-accepted mb-4';
                                alertMessage.textContent = 'Ordem Aceita';
                            } else {
                                alertDiv.className = 'alert-result alert-rejected mb-4';
                                alertMessage.textContent = 'Ordem Rejeitada: ' + (data.rejectReason || '');
                            }
                            statusText.textContent = '';
                            setTimeout(function() { window.location.href = '/'; }, 1500);
                        }
                    } else if (xhr.status === 404) {
                        clearInterval(poll);
                        statusText.textContent = 'Ordem nao encontrada';
                    }
                };
                xhr.send();
            }, 1000);
        }
    </script>
}
